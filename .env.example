# Copy to .env.local and fill in from https://dashboard.emailjs.com
# Account > General: public key. Email Services: service ID. Email Templates: template ID.
# Template variables: {{from_name}} {{reply_to}} {{company}} {{role}} {{message}}
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
